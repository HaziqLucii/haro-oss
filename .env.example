# Copy to .env and fill in for your machine:  cp .env.example .env
#
# UID/GID  → run `id -u` and `id -g` (so the container writes files as YOU, and
#            git worktree ownership stays clean).
# HOME_DIR → your home (holds ~/.claude auth + ~/.gitconfig identity).
# PROJECTS_DIR → parent dir of the repos you'll register in haro.
# WORKTREE_ROOT → where haro creates worktrees (default ~/.haro/worktrees).
#   PROJECTS_DIR and WORKTREE_ROOT are bind-mounted at the SAME path inside the
#   container so git's absolute worktree refs resolve identically.
UID=1000
GID=1000
HOME_DIR=/home/youruser
PROJECTS_DIR=/home/youruser/Projects
WORKTREE_ROOT=/home/youruser/.haro/worktrees
